{
  "navigationFallback": {
    "rewrite": "/api/proxy",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*", "/js/*", "*.{css,scss,js,png,gif,ico,jpg,svg}"]
  },
  "routes": [
    {
      "route": "/",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "rewrite": "/api/proxy"
    },
    {
      "route": "/*",
      "serve": "/api/proxy"
    }
  ]
}
